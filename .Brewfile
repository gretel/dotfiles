tap "emilevr/space"
tap "gretel/sdr", "https://github.com/gretel/homebrew-sdr.git"

# Static analysis and lint tool, for (ba)sh scripts
brew "shellcheck"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Multi-shell multi-command argument completer
brew "carapace"
# Emacs dependency management
brew "cask"
# Object-file caching compiler wrapper
brew "ccache"
# USB programmer
brew "dfu-util"
# Load/unload environment variables based on $PWD
brew "direnv"
# Static file server
brew "dufs"
# Friendly and expressive shell
brew "elvish"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Clone of ls with colorful output, file type icons, and more
brew "lsd"
# Mac App Store command-line interface
brew "mas"
# Password generator
brew "pwgen"
# Search tool like grep and The Silver Searcher
# Send macOS User Notifications from the command-line
brew "terminal-notifier"
# Simple TTY terminal I/O application
brew "tio"
# Terminal multiplexer
brew "tmux"
# CLI tool that moves files or folder to the trash
brew "trash", link: true
# Build, bundle & ship your Rust WASM application to the web
# Shell extension to navigate your filesystem faster
brew "zoxide"

# Analyze and clean your disk space (powered by Rust)
brew "emilevr/space/space"
# Monitors common persistence locations
cask "blockblock"
cask "font-hack-nerd-font"
# Desktop automation application
cask "hammerspoon"
# Convert your caps lock key or any of your modifier keys to the hyper key
cask "hyperkey"
# Free and open-source media player
cask "iina"
# Tool to optimise images to a smaller size
cask "imageoptim"
# Vector graphics editor
cask "inkscape"
# Tool to prevent the system from going into sleep mode
cask "keepingyouawake"
# File archiver
cask "keka"
# Tool to show what is persistently installed on the computer
cask "knockknock"
# Customise mouse behavior
cask "linearmouse@beta"
# Trims video and audio files losslessly
cask "losslesscut"
# Open-source firewall to block unknown outgoing connections
cask "lulu"
# Framework for development on BLE devices
cask "nrf-connect"
# Utility to uninstall apps and remove leftover files from old/uninstalled apps
cask "pearcleaner"
# Instant messaging application focusing on security
cask "signal"
# Text editor for code, markup and prose
cask "sublime-text@dev"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# GPU-accelerated cross-platform terminal emulator and multiplexer
cask "wezterm@nightly"
# Gecko based web browser
cask "zen@twilight"

mas "Keynote", id: 361285480
mas "Numbers", id: 361304891
mas "Pages", id: 361309726
